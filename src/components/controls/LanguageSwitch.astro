---
import { Icon } from "astro-icon/components";
---

<button
	type="button"
	data-language-switch
	data-no-translate
	class="btn-plain scale-animation rounded-lg h-11 px-2.5 gap-1 active:scale-90 shrink-0"
	aria-label="Switch interface to English"
	title="Switch interface to English"
>
	<Icon name="material-symbols:translate" class="text-[1.25rem]" />
	<span data-language-label class="text-xs font-bold" lang="en">EN</span>
</button>
